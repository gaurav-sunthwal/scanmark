# AWS credentials (used by services/aws_service.py)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# S3 storage for face photos
S3_REGION=eu-north-1
S3_BUCKET_NAME=scanmark-face-photos

# DynamoDB tables
DYNAMODB_STUDENTS_TABLE=students
DYNAMODB_ATTENDANCE_TABLE=attendance

# AWS Rekognition face collection
REKOGNITION_COLLECTION_ID=scanmark-faces

# Server port (defaults: 8080 in main.py, 8000 in application.py)
PORT=8080
