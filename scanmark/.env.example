# Backend API base URLs used by the Expo app (see utils/api.ts).
# These must be prefixed with EXPO_PUBLIC_ to be readable at runtime.

# Main attendance API (Next.js backend)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Face recognition API (Python/FastAPI backend)
EXPO_PUBLIC_FACE_API_BASE_URL=https://scanmark-2.onrender.com
